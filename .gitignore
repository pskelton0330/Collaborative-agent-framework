# Runtime coordination artifacts — generated while the framework runs.
# Committed: the empty folder structure (.gitkeep) and the pristine SEEDS
# (shared/status.seed.json, shared/master-log.seed.md). NOT committed: the live
# status.json / master-log.md (seeded from those on first use) and the live
# request/response/escalation/archive content.
shared/requests/*
shared/responses/*
shared/escalation/*
shared/archive/*
shared/plans/*
!shared/requests/.gitkeep
!shared/responses/.gitkeep
!shared/escalation/.gitkeep
!shared/archive/.gitkeep
!shared/plans/.gitkeep

# Staging / temp files (atomic-write intermediates)
*.draft
*.response.md.tmp
shared/*.tmp.*

# OS cruft
.DS_Store

# Live runtime state — seeded from shared/*.seed.* on first use (scripts/_common.sh),
# then mutated by real runs. Gitignored so real use can never dirty the repo or leak a
# task label / project path into history.
shared/status.json
shared/master-log.md

# Headless secondary runtime
shared/conversation.md
shared/.stop-secondary
shared/*.out
shared/*.out.1
shared/conversation.md.1
shared/.watcher.pid

# Per-session isolated coordination state (AF_STATE_DIR). Each concurrent /collab session
# gets its own shared/runs/<session-id>/ subtree so multiple Primaries never collide.
# Entirely runtime — never committed.
shared/runs/
