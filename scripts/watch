#!/bin/sh
# Block until there is work, then return.
#
#   watch                      Secondary mode: wait for any UNPROCESSED request
#                              (a request/escalation file with no matching
#                              response). Prints the id(s), exit 0.
#   watch --response <id>      Primary mode: wait until the response for <id>
#                              exists. Prints <id>, exit 0.
#   watch --max-idle <secs>    Override the idle timeout for THIS call only.
#                              Agent harnesses kill long foreground commands
#                              (e.g. a 2-minute tool timeout), so agents should
#                              wait in short chunks (e.g. --max-idle 90) and
#                              re-run on exit 2 until the TOTAL wait reaches
#                              status.json's max_idle_seconds.
#
# Exit codes: 0 = work found (ids printed) | 2 = idle timeout reached |
#             3 = paused (status.human_required is set; Secondary mode only).
# Poll interval and idle timeout come from status.json limits (defaults 8/900);
# --max-idle overrides the timeout per call.
set -eu
. "$(cd "$(dirname "$0")" && pwd)/_common.sh"

MODE="any"; WANT_ID=""; IDLE_OVERRIDE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --response) MODE="response"; WANT_ID=${2:-}; shift 2 ;;
    --max-idle) IDLE_OVERRIDE=${2:-}; shift 2 ;;
    -h|--help) echo "Usage: watch [--response <request-id>] [--max-idle <seconds>]" >&2; exit 2 ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done
[ "$MODE" = "response" ] && [ -z "$WANT_ID" ] && { echo "--response needs an id" >&2; exit 2; }
case "$IDLE_OVERRIDE" in
  '') : ;;
  *[!0-9]*|0) echo "--max-idle needs a positive integer (seconds)" >&2; exit 2 ;;
esac

INTERVAL=$(json_get '.limits.idle_poll_seconds' 8)
MAX_IDLE=$(json_get '.limits.max_idle_seconds' 900)
case "$INTERVAL" in *[!0-9]*|'') INTERVAL=8 ;; esac
case "$MAX_IDLE" in *[!0-9]*|'') MAX_IDLE=900 ;; esac
[ -n "$IDLE_OVERRIDE" ] && MAX_IDLE=$IDLE_OVERRIDE
# Never sleep past the deadline in one chunk (e.g. --max-idle 5 with the default
# 8s poll would otherwise overshoot to 8s).
[ "$INTERVAL" -gt "$MAX_IDLE" ] && INTERVAL=$MAX_IDLE

unprocessed() {
  out=""
  for f in "$REQUESTS"/*.md "$ESCALATION"/*.escalation.md; do
    [ -e "$f" ] || continue
    b=$(basename "$f")
    case "$b" in
      .gitkeep) continue ;;
      *.escalation.md) id=${b%.escalation.md} ;;
      *.md) id=${b%.md} ;;
      *) continue ;;
    esac
    [ -e "$RESPONSES/$id.response.md" ] && continue
    out="$out$id\n"
  done
  printf '%b' "$out"
}

elapsed=0
while : ; do
  if [ "$MODE" = "response" ]; then
    # Only treat the response as ready if it passes the FULL contract AND its embedded
    # request_id matches the id we're waiting on — a partial, hand-written, or wrong-id
    # file at the expected path does not unblock the wait. (The sanctioned
    # complete-request publishes atomically with a matching id, so this never
    # false-negatives a real response.)
    rf="$RESPONSES/$WANT_ID.response.md"
    if [ -e "$rf" ] && validate_response_file "$rf" 2>/dev/null && \
       [ "$(fm_value "$rf" request_id)" = "$WANT_ID" ]; then
      printf '%s\n' "$WANT_ID"
      exit 0
    fi
  else
    if [ "$(json_get '.human_required' false)" = "true" ]; then
      echo "PAUSED: status.human_required is set. Staying idle (no review)." >&2
      exit 3
    fi
    ids=$(unprocessed)
    if [ -n "$ids" ]; then
      printf '%s\n' "$ids" | sed '/^$/d'
      exit 0
    fi
  fi
  if [ "$elapsed" -ge "$MAX_IDLE" ]; then
    echo "IDLE: no work after ${MAX_IDLE}s." >&2
    exit 2
  fi
  sleep "$INTERVAL"
  elapsed=$((elapsed + INTERVAL))
done
