#!/bin/sh
# secondary-loop — PERSISTENT headless Secondary. Blocks on scripts/watch; when the
# Primary publishes a request it runs a headless review (via secondary-agent) and
# appends the exchange to shared/conversation.md. This is the headless equivalent of
# leaving a Secondary agent running in a second terminal: it auto-detects work, you
# don't invoke it per turn.
#
#   secondary-loop [--provider codex|claude] [--model M] [--idle SECS] [--once]
# Run it in the background (e.g. `nohup scripts/secondary-loop &`) next to your
# Primary. Stop: `touch shared/.stop-secondary` (graceful) or Ctrl-C — noticed within
# the loop's idle window. Exits 3 if the system is paused (status.human_required).
# --once handles a single request (testing).
#   --idle SECS  How long one idle wait blocks before the loop re-checks the stop
#                sentinel. Defaults to min(120, status.max_idle_seconds), deliberately
#                decoupled from max_idle_seconds (the Primary's much longer
#                dead-Secondary patience budget) so a graceful stop is noticed
#                promptly. Does NOT change how fast real requests are picked up.
set -eu
. "$(cd "$(dirname "$0")" && pwd)/_common.sh"

PROVIDER="${SECONDARY_PROVIDER:-codex}"; MODEL="${SECONDARY_MODEL:-}"; IDLE=""; ONCE=0
needval() { [ "$1" -ge 2 ] && [ "${2#-}" = "$2" ] || { echo "$3 needs a value" >&2; exit 2; }; }
while [ $# -gt 0 ]; do
  case "$1" in
    --provider) needval "$#" "${2-}" --provider; PROVIDER=$2; shift 2 ;;
    --model) needval "$#" "${2-}" --model; MODEL=$2; shift 2 ;;
    --idle) needval "$#" "${2-}" --idle; IDLE=$2; shift 2 ;;
    --once) ONCE=1; shift ;;
    -h|--help) awk 'NR==1{next}/^#/{sub(/^# ?/,"");print;next}{exit}' "$0"; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

# Validate --idle upfront with the SAME constraints as watch --max-idle, so an invalid
# value can't reach watch (which would exit 2 immediately and be mistaken for an idle
# timeout — silently skipping work in --once, or tight-looping in persistent mode).
case "${IDLE}" in
  '') : ;;
  *[!0-9]*|0*|????????*) echo "--idle needs a positive integer, 1-9999999 (seconds)" >&2; exit 2 ;;
esac

export FRAMEWORK_DIR   # so the agent command (and test stubs) can resolve paths
# Forward the chosen provider/model to secondary-agent (it reads these envs). Without
# this, `secondary-loop --provider claude` would silently fall back to codex.
SECONDARY_PROVIDER="$PROVIDER"; SECONDARY_MODEL="$MODEL"; export SECONDARY_PROVIDER SECONDARY_MODEL
AGENT_CMD="${SECONDARY_AGENT_CMD:-$FRAMEWORK_DIR/scripts/secondary-agent}"
CONV="$SHARED/conversation.md"
STOP="$SHARED/.stop-secondary"
INTERVAL=$(json_get '.limits.idle_poll_seconds' 8); case "$INTERVAL" in *[!0-9]*|'') INTERVAL=8 ;; esac
fails=0; last_fail=""

# Decouple the loop's stop-check cadence from status.max_idle_seconds. That limit is
# the PRIMARY's patience budget before it declares the Secondary dead — deliberately
# generous (default 900s). If the loop inherited it as its OWN idle window, a graceful
# stop (.stop-secondary) would not be noticed until that whole window elapsed (the stop
# sentinel is only re-checked between watch calls). So when --idle isn't given, cap the
# loop's idle at STOP_POLL: the sentinel is checked at least that often, with NO effect
# on how fast real requests are picked up (watch returns the instant work appears) and
# none on the Primary's budget. An explicit --idle still wins.
STOP_POLL=120
if [ -n "$IDLE" ]; then
  EFFECTIVE_IDLE=$IDLE
else
  _mi=$(json_get '.limits.max_idle_seconds' 900); case "$_mi" in *[!0-9]*|'') _mi=900 ;; esac
  if [ "$_mi" -lt 1 ]; then EFFECTIVE_IDLE=$STOP_POLL
  elif [ "$_mi" -lt "$STOP_POLL" ]; then EFFECTIVE_IDLE=$_mi
  else EFFECTIVE_IDLE=$STOP_POLL; fi
fi

# print lines of a markdown '## Section' (until the next '## '), capped
section() { awk -v h="$1" 'index($0,h)==1{f=1;next} f&&/^## /{f=0} f{print}' "$2" | sed '/^$/d' | head -8; }
files_of() { awk '/^files:/{f=1;next} f&&/^[[:space:]]*-[[:space:]]*/{sub(/^[[:space:]]*-[[:space:]]*/,"");printf "%s ",$0;next} f&&/^[^[:space:]]/{f=0}' "$1"; }

append_transcript() {
  id=$1; req="$REQUESTS/$id.md"; [ -e "$req" ] || req="$ESCALATION/$id.escalation.md"
  resp="$RESPONSES/$id.response.md"
  if [ ! -f "$CONV" ]; then
    printf '# Agent conversation log\n\nAppend-only, human-readable transcript of Primary<->Secondary exchanges handled headlessly. Companion to master-log.md (terse events).\n' > "$CONV"
  fi
  {
    printf '\n## [%s] %s\n' "$(now_iso)" "$id"
    printf -- '- secondary: %s%s\n' "$PROVIDER" "${MODEL:+ ($MODEL)}"
    [ -e "$req" ] && printf -- '- request: type=%s files=[%s]\n' "$(fm_value "$req" type)" "$(files_of "$req" | sed 's/ $//')"
    if [ -f "$resp" ]; then
      printf -- '- verdict: %s (risk %s, cycle %s)\n' \
        "$(fm_value "$resp" approval)" "$(fm_value "$resp" risk)" "$(fm_value "$resp" review_cycle)"
      printf -- '\n  Findings:\n';  section '## Findings' "$resp" | sed 's/^/    /'
      printf -- '\n  Rationale:\n'; section '## Approval rationale' "$resp" | sed 's/^/    /'
    else
      printf -- '- (no response published; the secondary agent may have failed)\n'
    fi
  } >> "$CONV"
}

echo "secondary-loop: watching with provider=$PROVIDER (idle window ${EFFECTIVE_IDLE}s). stop with: touch $STOP" >&2
while : ; do
  if [ -e "$STOP" ]; then rm -f "$STOP"; echo "secondary-loop: stop sentinel seen — exiting." >&2; exit 0; fi
  set -- --max-idle "$EFFECTIVE_IDLE"
  ids=$("$FRAMEWORK_DIR/scripts/watch" "$@" 2>/dev/null) && rc=0 || rc=$?
  case "$rc" in
    0)
      # Single-active rule: prefer the status.active_request id; if it isn't among the
      # unprocessed set and there's more than one, decline and let the Primary reconcile.
      active=$(json_get '.active_request' "")
      if [ -n "$active" ] && printf '%s\n' "$ids" | grep -qx "$active"; then
        id=$active
      elif [ "$(printf '%s\n' "$ids" | sed '/^$/d' | grep -c .)" -le 1 ]; then
        id=$(printf '%s\n' "$ids" | sed '/^$/d' | head -1)
      else
        echo "secondary-loop: >1 unprocessed and none matches active_request; leaving for the Primary." >&2
        id=""
      fi
      if [ -z "$id" ]; then
        [ "$ONCE" = 1 ] && exit 0
        sleep "$INTERVAL"; continue
      fi
      echo "secondary-loop: reviewing $id ($PROVIDER)" >&2
      "$AGENT_CMD" "$id" >&2 2>&1 || true
      if [ -f "$RESPONSES/$id.response.md" ]; then
        append_transcript "$id"
        log_append "SECONDARY" "HEADLESS_REVIEW" "Headless $PROVIDER review of $id." "$id"
        fails=0; last_fail=""
        [ "$ONCE" = 1 ] && exit 0
      else
        # A failed review must NOT look successful (no transcript/log); surface it.
        echo "secondary-loop: no response published for $id (agent failed)." >&2
        [ "$ONCE" = 1 ] && exit 1
        if [ "$id" = "$last_fail" ]; then fails=$((fails + 1)); else fails=1; last_fail=$id; fi
        [ "$fails" -ge 3 ] && { echo "secondary-loop: giving up on $id after $fails failed attempts." >&2; exit 1; }
        sleep "$INTERVAL"   # back off instead of tight-looping on the same unprocessed request
      fi
      ;;
    2) if [ "$ONCE" = 1 ]; then echo "secondary-loop: idle (--once) — nothing to do." >&2; exit 0; fi ;;
    3) echo "secondary-loop: PAUSED (status.human_required) — exiting; clear the pause and restart." >&2; exit 3 ;;
    *) echo "secondary-loop: watch error (rc=$rc) — exiting." >&2; exit 1 ;;
  esac
done
