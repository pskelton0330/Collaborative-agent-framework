#!/bin/sh
# secondary-loop — PERSISTENT headless Secondary. Blocks on scripts/watch; when the
# Primary publishes a request it runs a headless review (via secondary-agent) and
# appends the exchange to shared/conversation.md. This is the headless equivalent of
# leaving a Secondary agent running in a second terminal: it auto-detects work, you
# don't invoke it per turn.
#
#   secondary-loop [--provider codex|claude] [--model M] [--idle SECS] [--once]
# Run it in the background (e.g. `nohup scripts/secondary-loop &`) next to your
# Primary. Stop: `touch shared/.stop-secondary` (graceful) or Ctrl-C — noticed within
# the loop's idle window. Exits 3 if the system is paused (status.human_required).
# --once handles a single request (testing).
#   --idle SECS  How long one idle wait blocks before the loop re-checks the stop
#                sentinel. Defaults to min(120, status.max_idle_seconds), deliberately
#                decoupled from max_idle_seconds (the Primary's much longer
#                dead-Secondary patience budget) so a graceful stop is noticed
#                promptly. Does NOT change how fast real requests are picked up.
set -eu
. "$(cd "$(dirname "$0")" && pwd)/_common.sh"

PROVIDER="${SECONDARY_PROVIDER:-codex}"; MODEL="${SECONDARY_MODEL:-}"; IDLE=""; ONCE=0
needval() { [ "$1" -ge 2 ] && [ "${2#-}" = "$2" ] || { echo "$3 needs a value" >&2; exit 2; }; }
while [ $# -gt 0 ]; do
  case "$1" in
    --provider) needval "$#" "${2-}" --provider; PROVIDER=$2; shift 2 ;;
    --model) needval "$#" "${2-}" --model; MODEL=$2; shift 2 ;;
    --idle) needval "$#" "${2-}" --idle; IDLE=$2; shift 2 ;;
    --once) ONCE=1; shift ;;
    -h|--help) awk 'NR==1{next}/^#/{sub(/^# ?/,"");print;next}{exit}' "$0"; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

# Validate --idle upfront with the SAME constraints as watch --max-idle, so an invalid
# value can't reach watch (which would exit 2 immediately and be mistaken for an idle
# timeout — silently skipping work in --once, or tight-looping in persistent mode).
case "${IDLE}" in
  '') : ;;
  *[!0-9]*|0*|????????*) echo "--idle needs a positive integer, 1-9999999 (seconds)" >&2; exit 2 ;;
esac

export FRAMEWORK_DIR   # so the agent command (and test stubs) can resolve paths
# Forward the chosen provider/model to secondary-agent (it reads these envs). Without
# this, `secondary-loop --provider claude` would silently fall back to codex.
SECONDARY_PROVIDER="$PROVIDER"; SECONDARY_MODEL="$MODEL"; export SECONDARY_PROVIDER SECONDARY_MODEL
AGENT_CMD="${SECONDARY_AGENT_CMD:-$FRAMEWORK_DIR/scripts/secondary-agent}"
CONV="$SHARED/conversation.md"
STOP="$SHARED/.stop-secondary"
INTERVAL=$(json_get '.limits.idle_poll_seconds' 8); case "$INTERVAL" in *[!0-9]*|'') INTERVAL=8 ;; esac
fails=0; last_fail=""

# Single-watcher lock (per state dir), so two watchers on ONE coordination state can't
# double-process requests / race the transcript. The claim is an ATOMIC `mkdir` of a lock
# DIRECTORY: exactly one racer wins a concurrent start (a pid-FILE check-then-write would
# let both through). ALL modes contend — a `--once` review is NOT short if it runs a full
# agent review beside a persistent watcher. The REAL fix for concurrency is one
# AF_STATE_DIR per session; this backstop just makes an accidental double-watch fail loudly.
LOCKDIR="$SHARED/.watcher.lock"
# Claim is a single ATOMIC mkdir — exactly one racer can win, EVER. We deliberately do NOT
# auto-reclaim a stale lock: any rm-then-remkdir dance reintroduces a race (two starters can
# both delete + recreate). So if mkdir fails we ALWAYS refuse; a lock left by a *crashed*
# watcher is surfaced by `doctor` with the exact `rm -rf` to clear. Fail-closed, race-free.
if mkdir "$LOCKDIR" 2>/dev/null; then
  # Owner-token = our pid. Publication is MANDATORY: on failure, remove only the dir we
  # just created and refuse (never leave a claimed-but-unowned lock).
  if ! echo $$ > "$LOCKDIR/pid" 2>/dev/null; then
    rm -rf "$LOCKDIR"
    echo "secondary-loop: could not write lock owner pid in $SHARED — refusing." >&2
    exit 2
  fi
  # Cleanup removes the lock ONLY while we still own it (token still matches our pid) — so a
  # cleanup can never delete a lock that is not ours. INT/TERM must EXPLICITLY exit: a POSIX
  # trap does not imply exit, so without it a signalled watcher would keep running unlocked.
  _release_lock() { if [ "$(cat "$LOCKDIR/pid" 2>/dev/null || echo)" = "$$" ]; then rm -rf "$LOCKDIR"; fi; }
  trap '_release_lock' EXIT
  trap '_release_lock; exit 130' INT
  trap '_release_lock; exit 143' TERM
else
  # Guarded read (|| echo) so a missing/unreadable pid file can't abort us under set -e.
  owner=$(cat "$LOCKDIR/pid" 2>/dev/null || echo "?")
  echo "secondary-loop: another watcher (pid $owner) already owns this state dir:" >&2
  echo "  $SHARED" >&2
  echo "Give each concurrent session its own AF_STATE_DIR. If this lock is stale (the owner" >&2
  echo "crashed — 'doctor' confirms), clear it: rm -rf \"$LOCKDIR\". Refusing to double-watch." >&2
  exit 5
fi

# Decouple the loop's stop-check cadence from status.max_idle_seconds. That limit is
# the PRIMARY's patience budget before it declares the Secondary dead — deliberately
# generous (default 900s). If the loop inherited it as its OWN idle window, a graceful
# stop (.stop-secondary) would not be noticed until that whole window elapsed (the stop
# sentinel is only re-checked between watch calls). So when --idle isn't given, cap the
# loop's idle at STOP_POLL: the sentinel is checked at least that often, with NO effect
# on how fast real requests are picked up (watch returns the instant work appears) and
# none on the Primary's budget. An explicit --idle still wins.
STOP_POLL=120
if [ -n "$IDLE" ]; then
  EFFECTIVE_IDLE=$IDLE
else
  _mi=$(json_get '.limits.max_idle_seconds' 900); case "$_mi" in *[!0-9]*|'') _mi=900 ;; esac
  if [ "$_mi" -lt 1 ]; then EFFECTIVE_IDLE=$STOP_POLL
  elif [ "$_mi" -lt "$STOP_POLL" ]; then EFFECTIVE_IDLE=$_mi
  else EFFECTIVE_IDLE=$STOP_POLL; fi
fi

# print lines of a markdown '## Section' (until the next '## '), capped
section() { awk -v h="$1" 'index($0,h)==1{f=1;next} f&&/^## /{f=0} f{print}' "$2" | sed '/^$/d' | head -8; }
files_of() { awk '/^files:/{f=1;next} f&&/^[[:space:]]*-[[:space:]]*/{sub(/^[[:space:]]*-[[:space:]]*/,"");printf "%s ",$0;next} f&&/^[^[:space:]]/{f=0}' "$1"; }

append_transcript() {
  id=$1; req="$REQUESTS/$id.md"; [ -e "$req" ] || req="$ESCALATION/$id.escalation.md"
  resp="$RESPONSES/$id.response.md"
  if [ ! -f "$CONV" ]; then
    printf '# Agent conversation log\n\nAppend-only, human-readable transcript of Primary<->Secondary exchanges handled headlessly. Companion to master-log.md (terse events).\n' > "$CONV"
  fi
  {
    printf '\n## [%s] %s\n' "$(now_iso)" "$id"
    printf -- '- secondary: %s%s\n' "$PROVIDER" "${MODEL:+ ($MODEL)}"
    [ -e "$req" ] && printf -- '- request: type=%s files=[%s]\n' "$(fm_value "$req" type)" "$(files_of "$req" | sed 's/ $//')"
    if [ -f "$resp" ]; then
      printf -- '- verdict: %s (risk %s, cycle %s)\n' \
        "$(fm_value "$resp" approval)" "$(fm_value "$resp" risk)" "$(fm_value "$resp" review_cycle)"
      printf -- '\n  Findings:\n';  section '## Findings' "$resp" | sed 's/^/    /'
      printf -- '\n  Rationale:\n'; section '## Approval rationale' "$resp" | sed 's/^/    /'
    else
      printf -- '- (no response published; the secondary agent may have failed)\n'
    fi
  } >> "$CONV"
}

# Rotate conversation.md when it grows past the cap, so the append-only transcript can't
# grow unbounded. Keeps ONE rolling backup (conversation.md.1, overwritten each rotation),
# bounding on-disk size to ~2x the cap. Bytes-based; cap via AF_CONV_MAX_KB (default 512).
# doctor flags an oversized .1 backup. Called BOTH at startup (rotates a large transcript
# left by a prior session) AND after each append (bounds a single long-lived loop, not
# just across restarts). Callers gate it on the pause/stop state so a paused system stays
# frozen (see below). NOTE: single-Secondary is assumed — this is not locked against a
# second concurrent secondary-loop racing the size-check/mv (unsupported configuration).
CONV_MAX_KB=${AF_CONV_MAX_KB:-512}
case "$CONV_MAX_KB" in ''|*[!0-9]*|??????????*) CONV_MAX_KB=512 ;; esac  # non-int/overflow -> default
maybe_rotate_conv() {
  # Defense in depth: a human-paused system does NO automation and a pending stop means we
  # are exiting — in neither case may ANY caller rotate the transcript (PROTOCOL §14).
  { [ -e "$STOP" ] || [ "$(json_get '.human_required' false)" = "true" ]; } && return 0
  [ -f "$CONV" ] || return 0
  cbytes=$(wc -c < "$CONV" 2>/dev/null) || return 0
  [ "$(( cbytes / 1024 ))" -ge "$CONV_MAX_KB" ] || return 0
  # Rotation is REQUIRED now (over cap). If it cannot happen, WARN and return nonzero —
  # never report success while leaving the transcript over the cap. Reviews still continue
  # (the transcript is non-authoritative; doctor's oversized-log check is the backstop) —
  # halting the Secondary over a log-rotation hiccup would be disproportionate.
  if [ -e "$CONV.1" ] && [ ! -f "$CONV.1" ]; then
    echo "secondary-loop: WARNING conversation.md.1 is not a regular file — cannot rotate; transcript over cap." >&2
    return 1
  fi
  if mv "$CONV" "$CONV.1"; then
    echo "secondary-loop: rotated conversation.md ($(( cbytes / 1024 ))KB >= ${CONV_MAX_KB}KB) -> conversation.md.1" >&2
    return 0
  fi
  echo "secondary-loop: WARNING failed to rotate conversation.md (mv failed) — transcript over cap." >&2
  return 1
}

maybe_rotate_conv || true   # startup: rotate a stale large transcript (|| true: a rotation
                            # failure warns inside the fn but must NOT abort the watcher under set -e)

echo "secondary-loop: watching with provider=$PROVIDER (idle window ${EFFECTIVE_IDLE}s). stop with: touch $STOP" >&2
while : ; do
  if [ -e "$STOP" ]; then rm -f "$STOP"; echo "secondary-loop: stop sentinel seen — exiting." >&2; exit 0; fi
  set -- --max-idle "$EFFECTIVE_IDLE"
  ids=$("$FRAMEWORK_DIR/scripts/watch" "$@" 2>/dev/null) && rc=0 || rc=$?
  case "$rc" in
    0)
      # Single-active rule: prefer the status.active_request id; if it isn't among the
      # unprocessed set and there's more than one, decline and let the Primary reconcile.
      active=$(json_get '.active_request' "")
      if [ -n "$active" ] && printf '%s\n' "$ids" | grep -qx "$active"; then
        id=$active
      elif [ "$(printf '%s\n' "$ids" | sed '/^$/d' | grep -c .)" -le 1 ]; then
        id=$(printf '%s\n' "$ids" | sed '/^$/d' | head -1)
      else
        echo "secondary-loop: >1 unprocessed and none matches active_request; leaving for the Primary." >&2
        id=""
      fi
      if [ -z "$id" ]; then
        [ "$ONCE" = 1 ] && exit 0
        sleep "$INTERVAL"; continue
      fi
      echo "secondary-loop: reviewing $id ($PROVIDER)" >&2
      "$AGENT_CMD" "$id" >&2 2>&1 || true
      # Accept a review as complete ONLY if the final file is a VALID response for THIS id —
      # not merely present. The agent runs in workspace-write and could (by accident or via
      # prompt injection in reviewed material) write a truncated, malformed, or wrong-id file
      # directly, bypassing complete-request. A bare existence test would then log a nominal
      # review AND — because watch treats any final file as "processed" — permanently hide the
      # request from the queue. (complete-request uses the same validator, so a legitimately
      # published response always passes this.)
      _resp="$RESPONSES/$id.response.md"
      if [ -f "$_resp" ] && validate_response_file "$_resp" >/dev/null 2>&1 \
         && [ "$(fm_value "$_resp" request_id)" = "$id" ]; then
        # The agent may have run for minutes; a pause/stop could have been established while
        # it ran (and complete-request already handed ownership to the Primary). Do NOT
        # mutate shared state (transcript/rotation/log) on a now-paused or stopping system
        # (PROTOCOL §14). The response itself is already published by the agent — the
        # Secondary's own allowed transition — so we just skip the bookkeeping.
        if [ -e "$STOP" ] || [ "$(json_get '.human_required' false)" = "true" ]; then
          echo "secondary-loop: pause/stop detected after review of $id — skipping transcript/log." >&2
        else
          append_transcript "$id"
          maybe_rotate_conv || true   # bound growth WITHIN a long-lived loop (|| true so a
                                      # rotation failure warns but never aborts the watcher under set -e)
          log_append "SECONDARY" "HEADLESS_REVIEW" "Headless $PROVIDER review of $id." "$id"
        fi
        fails=0; last_fail=""
        [ "$ONCE" = 1 ] && exit 0
      else
        # A failed review must NOT look successful (no transcript/log); surface it. If a
        # final file exists but is INVALID or for the wrong id, discard it — otherwise it
        # would masquerade as "processed" (watch keys off the final path) and block retries.
        if [ -f "$_resp" ]; then
          echo "secondary-loop: $id produced an invalid/mismatched response — discarding it." >&2
          rm -f "$_resp"
        else
          echo "secondary-loop: no response published for $id (agent failed)." >&2
        fi
        [ "$ONCE" = 1 ] && exit 1
        if [ "$id" = "$last_fail" ]; then fails=$((fails + 1)); else fails=1; last_fail=$id; fi
        [ "$fails" -ge 3 ] && { echo "secondary-loop: giving up on $id after $fails failed attempts." >&2; exit 1; }
        sleep "$INTERVAL"   # back off instead of tight-looping on the same unprocessed request
      fi
      ;;
    2) if [ "$ONCE" = 1 ]; then echo "secondary-loop: idle (--once) — nothing to do." >&2; exit 0; fi ;;
    3) echo "secondary-loop: PAUSED (status.human_required) — exiting; clear the pause and restart." >&2; exit 3 ;;
    *) echo "secondary-loop: watch error (rc=$rc) — exiting." >&2; exit 1 ;;
  esac
done
